{
	"name": "svelte-cookie-consent",
	"version": "2.4.0",
	"description": "A GDPR compliant cookie banner",
	"license": "MIT",
	"author": {
		"name": "Sebastiano Racca",
		"url": "https://racca.me",
		"email": "sebastiano@racca.me"
	},
	"repository": {
		"url": "git+https://github.com/SebaOfficial/svelte-cookie-consent.git"
	},
	"homepage": "https://svelte-cookie-consent.js.org/",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm build:docs && pnpm build:demo && pnpm build:dist",
		"build:demo": "vite build",
		"build:docs": "typedoc",
		"build:js": "vite -c vite.js.config.ts build && mv dist-js/* dist/ && rmdir dist-js",
		"build:dist": "pnpm prepack && pnpm build:js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && husky",
		"prepack": "svelte-kit sync && svelte-package && publint && pnpm build:js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^24.19.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"publint": "^0.3.25",
		"sass": "^1.105.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"js-cookie": "^3.0.8",
		"uuid": "^11.1.1"
	},
	"keywords": [
		"svelte",
		"cookie",
		"cookies",
		"cookie-banner",
		"gdpr"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
